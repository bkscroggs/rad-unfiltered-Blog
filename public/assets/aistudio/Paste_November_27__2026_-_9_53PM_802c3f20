  <script>
    (function () {
      const root = document.documentElement;
      const themeToggle = document.getElementById('theme-toggle');
      const themeIcon = document.getElementById('theme-icon');
      const tabs = document.querySelectorAll('.modality-tab');
      const tiles = document.querySelectorAll('.modality-tile');
      const grid = document.getElementById('dispatch-grid');
      const cards = Array.from(document.querySelectorAll('.dispatch-card'));
      const searchInput = document.getElementById('article-search');
      const sortSelect = document.getElementById('sort-select');
      const visibleCount = document.getElementById('visible-count');
      const bookmarkBtns = document.querySelectorAll('.bookmark-btn');
      const savedCountLabel = document.getElementById('saved-count-label');
      let savedCount = 3;
      let activeModality = 'All';

      if (themeToggle) {
        themeToggle.addEventListener('click', function () {
          const isDark = root.classList.toggle('dark');
          themeIcon.textContent = isDark ? 'light_mode' : 'dark_mode';
        });
      }

      document.addEventListener('keydown', function (e) {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (searchInput) searchInput.focus();
        }
      });

      function applySort() {
        if (!grid || !sortSelect) return;
        const mode = sortSelect.value;
        const sorted = cards.slice().sort(function (a, b) {
          const da = a.getAttribute('data-date') || '';
          const db = b.getAttribute('data-date') || '';
          const ma = Number(a.getAttribute('data-minutes') || 0);
          const mb = Number(b.getAttribute('data-minutes') || 0);
          if (mode === 'oldest') return da.localeCompare(db);
          if (mode === 'shortest') return ma - mb;
          if (mode === 'longest') return mb - ma;
          return db.localeCompare(da);
        });
        sorted.forEach(function (card) { grid.appendChild(card); });
      }

      function applyFilters() {
        const query = (searchInput && searchInput.value ? searchInput.value : '').trim().toLowerCase();
        let shown = 0;
        cards.forEach(function (card) {
          const mod = card.getAttribute('data-modality') || '';
          const text = card.textContent.toLowerCase();
          const modMatch = activeModality === 'All' || mod === activeModality;
          const queryMatch = !query || text.includes(query);
          const visible = modMatch && queryMatch;
          card.classList.toggle('hidden', !visible);
          if (visible) shown += 1;
        });
        if (visibleCount) {
          visibleCount.textContent = 'Showing ' + shown + ' of ' + cards.length;
        }
      }

      function selectModality(modality) {
        activeModality = modality;
        tabs.forEach(function (t) {
          const isMatch = t.getAttribute('data-tab-modality') === modality;
          t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          t.className = isMatch
            ? 'modality-tab px-gutter-md py-gutter-xs rounded-sm bg-light-primary text-light-on-primary dark:bg-dark-primary dark:text-dark-on-primary font-label whitespace-nowrap transition-colors duration-state-change'
            : 'modality-tab px-gutter-md py-gutter-xs rounded-sm text-light-on-surface-variant dark:text-dark-on-surface-variant hover:text-light-on-surface dark:hover:text-dark-on-surface font-label whitespace-nowrap transition-colors duration-state-change';
        });
        applyFilters();
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          selectModality(tab.getAttribute('data-tab-modality'));
        });
      });

      tiles.forEach(function (tile) {
        tile.addEventListener('click', function () {
          selectModality(tile.getAttribute('data-modality-filter'));
        });
      });

      if (searchInput) {
        searchInput.addEventListener('input', applyFilters);
      }

      if (sortSelect) {
        sortSelect.addEventListener('change', applySort);
      }

      bookmarkBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          const icon = btn.querySelector('.material-symbols-outlined');
          const saved = icon.textContent === 'bookmark';
          icon.textContent = saved ? 'bookmark_border' : 'bookmark';
          savedCount += saved ? -1 : 1;
          if (savedCountLabel) {
            savedCountLabel.textContent = 'Saved (' + savedCount + ')';
          }
        });
      });
    })();
  </script>


